<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- 1. PUBLIC PROPERTIES CATALOG TEMPLATE -->
        <template id="property_list_template" name="Available Properties">
            <t t-call="website.layout">
                <div id="wrap" class="re-property-page">
                    <section class="re-listing-intro">
                        <div class="re-container">
                            <p class="re-eyebrow">A better place to land</p>
                            <h1>Find a home that feels like yours.</h1>
                            <p class="re-lede">Explore considered homes and spaces available to rent. Search by name or description, then get in touch to arrange a visit.</p>
                            <form action="/properties" method="get" class="re-search-form">
                                <input type="search" name="q" placeholder="Try a property name or feature" t-att-value="search_query" aria-label="Search properties"/>
                                <select name="type" aria-label="Filter by property type">
                                    <option value="">All property types</option>
                                    <option value="apartment" t-att-selected="selected_type == 'apartment'">Apartments</option>
                                    <option value="house" t-att-selected="selected_type == 'house'">Houses</option>
                                    <option value="villa" t-att-selected="selected_type == 'villa'">Villas</option>
                                    <option value="commercial" t-att-selected="selected_type == 'commercial'">Commercial</option>
                                </select>
                                <button type="submit">Search homes</button>
                            </form>
                        </div>
                    </section>

                    <section class="re-results">
                        <div class="re-container">
                            <div class="re-results-heading">
                                <h2>Available properties</h2>
                                <span class="re-results-count"><t t-esc="len(properties)"/> homes to explore</span>
                            </div>
                            <div class="row g-4">
                                <t t-foreach="properties" t-as="prop">
                                    <div class="col-md-6 col-xl-4">
                                        <article class="re-property-card">
                                            <a t-attf-href="/properties/#{prop.id}" t-att-aria-label="'View ' + prop.name">
                                                <img t-if="prop.image_1920" class="re-property-image" t-att-src="'/web/image/real_estate.property/%s/image_1920' % prop.id" t-att-alt="prop.name" loading="lazy"/>
                                                <div t-else="" class="re-property-placeholder" role="img" aria-label="Representative home photograph"/>
                                            </a>
                                            <div class="re-property-card-body">
                                                <span class="re-property-type" t-esc="prop.property_type"/>
                                                <h3 t-esc="prop.name"/>
                                                <p class="re-property-description" t-esc="prop.description or 'A welcoming space, ready for its next chapter.'"/>
                                                <div class="re-property-meta">
                                                    <span class="re-property-price">$<t t-esc="prop.price"/> <small>/ month</small></span>
                                                    <span class="re-bedroom-count"><t t-esc="prop.bedrooms"/> bedrooms</span>
                                                </div>
                                                <a class="re-property-link" t-attf-href="/properties/#{prop.id}">Explore property <span aria-hidden="true">&#8594;</span></a>
                                            </div>
                                        </article>
                                    </div>
                                </t>
                                <t t-if="not properties">
                                    <div class="col-12">
                                        <div class="re-empty-state">
                                            <h3>No homes match that search.</h3>
                                            <p>Try another phrase or broaden your property type.</p>
                                            <a href="/properties">See all available properties</a>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </section>
                </div>
            </t>
        </template>

        <!-- 2. PROPERTY DETAIL TEMPLATE -->
        <template id="property_detail_template" name="Property Detail">
            <t t-call="website.layout">
                <div id="wrap" class="re-property-page">
                    <div class="re-container">
                        <nav class="re-detail-top" aria-label="Breadcrumb">
                            <a href="/properties">All properties</a>
                            <span aria-hidden="true"> / </span>
                            <span t-esc="property.name"/>
                        </nav>
                        <div class="re-detail-layout">
                            <main>
                                <img t-if="property.image_1920" class="re-detail-image" t-att-src="'/web/image/real_estate.property/%s/image_1920' % property.id" t-att-alt="property.name"/>
                                <div t-else="" class="re-detail-image" role="img" aria-label="Representative home photograph"/>
                                <div class="re-detail-copy">
                                    <p class="re-eyebrow">Available to rent</p>
                                    <h1 t-esc="property.name"/>
                                    <span class="re-detail-badge" t-esc="property.property_type"/>
                                    <p class="re-detail-description" t-esc="property.description or 'A welcoming space, ready for its next chapter.'"/>
                                </div>
                            </main>
                            <aside class="re-booking-panel">
                                <div class="re-detail-rent">$<t t-esc="property.price"/> <small>/ month</small></div>
                                <dl class="re-detail-facts">
                                    <div class="re-detail-fact">
                                        <dt>Bedrooms</dt>
                                        <dd t-esc="property.bedrooms"/>
                                    </div>
                                    <div class="re-detail-fact">
                                        <dt>Deposit</dt>
                                        <dd>$<t t-esc="property.deposit"/></dd>
                                    </div>
                                </dl>
                                <p class="re-agent-note">Interested in making this your next home? Our team can answer questions and arrange a visit.<br/><t t-if="property.agent_id"><strong>Agent:</strong> <t t-esc="property.agent_id.name"/></t></p>
                                <a href="/contactus" class="re-contact-button">Enquire about this property</a>
                            </aside>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- 3. TENANT PORTAL DASHBOARD TEMPLATE -->
        <template id="tenant_portal_template" name="My Leases &amp; Requests">
            <t t-call="website.layout">
                <div id="wrap" class="container my-5">
                    <h2>Welcome, <t t-esc="tenant.name if tenant else 'Valued Tenant'"/></h2>
                    <hr/>

                    <div class="row mt-4">
                        <div class="col-12">
                            <h3>My Leases</h3>
                            <table class="table table-striped mt-3">
                                <thead>
                                    <tr>
                                        <th>Reference</th>
                                        <th>Property</th>
                                        <th>Start Date</th>
                                        <th>End Date</th>
                                        <th>Monthly Rent</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="leases" t-as="lease">
                                        <tr>
                                            <td t-esc="lease.name"/>
                                            <td t-esc="lease.property_id.name"/>
                                            <td t-esc="lease.start_date"/>
                                            <td t-esc="lease.end_date"/>
                                            <td>$<t t-esc="lease.monthly_rent"/></td>
                                            <td>
                                                <span t-attf-class="badge bg-#{'success' if lease.state == 'active' else 'warning' if lease.state == 'at_risk' else 'secondary'}"
                                                      t-esc="lease.state"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="row mt-5">
                        <div class="col-12">
                            <h3>Maintenance Requests</h3>
                            <table class="table table-bordered mt-3">
                                <thead>
                                    <tr>
                                        <th>Issue Type</th>
                                        <th>Description</th>
                                        <th>Urgency</th>
                                        <th>Scheduled Date</th>
                                        <th>State</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="maintenance_requests" t-as="req">
                                        <tr>
                                            <td class="text-capitalize" t-esc="req.issue_type"/>
                                            <td t-esc="req.description"/>
                                            <td t-esc="req.urgency"/>
                                            <td t-esc="req.scheduled_date or 'Not Scheduled'"/>
                                            <td t-esc="req.state"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- 4. WEBSITE NAVBAR MENU ENTRY -->
        <record id="menu_website_properties" model="website.menu">
            <field name="name">Properties</field>
            <field name="url">/properties</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" eval="10"/>
        </record>

    </data>
</odoo>