<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Property List View (Tree) -->
    <record id="view_property_tree" model="ir.ui.view">
    <!--model="ir.ui.view" ======= in db to be stored as a table so you can run it immediately from db instead of loading all of that every single time-->
        <field name="name">real_estate.property.tree</field>
        <field name="model">real_estate.property</field>
        <field name="arch" type="xml">
            <tree string="Properties" decoration-info="property_type == 'apartment'" decoration-warning="property_type == 'villa'">
                <field name="name"/>
                <field name="property_type"/>
                <field name="price"/>
                <field name="bedrooms"/>
                <field name="create_date"/>
                <field name="create_uid"/>
                <field name="agent_id"/>
            </tree>
        </field>
    </record>

<!-- Property Form View -->
    <record id="view_property_form" model="ir.ui.view">
        <field name="name">real_estate.property.form</field>
        <field name="model">real_estate.property</field>
        <field name="arch" type="xml">
            <form string="Property">
                <header>
                    <button name="mark_as_occupied" string="Mark as Occupied" type="object" invisible="not available" class="oe_highlight"/>
                    <button name="mark_as_available" string="Mark as Available" type="object" invisible="available" class="oe_highlight"/>
                    <field name="available" invisible="1"/>  
                    <button name="update_description" string="Description" type="object" class="oe_highlight"/>  
                    <button name="increase_deposit" string="Add 1000 to Deposit" type="object" class="oe_highlight"/>
                    <button name="add_bedroom" string="Add 1 bedroom" groups="real_estate.group_property_manager" type="object" invisible="not available" class="oe_highlight"/>
                    <button name="make_property_as_villa" string="Make it villa" type="object" class="oe_highlight"/>
                    <button name="get_agent_name" string="Agent Name" type="object" class="oe_highlight"/> 
                    <button name="%(real_estate.action_lease_wizard)d" string="Lease" type="action" context="{'default_property_id': active_id}" />
                </header>

                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'size': [128, 128]}"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_lease" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-file-text-o">
                            <field name="lease_ids" widget="statinfo" string="Lease"/>
                        </button>
                        <button name="action_open_maintenance"
                                type="object" class="oe_stat_button" 
                                icon="fa-wrench">
                            <field name="maintenance_ids" widget="statinfo" string="Maintenance"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Property Name"/>                 
                        </h1>
                    </div>
                    <group string="Property Details">
                        <group>
                            <field name="property_type"/>
                            <field name="available"/>
                        </group>
                        <group>
                            <field name="price" invisible="not available"/>
                            <field name="deposit" string="Deposit Amount"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="bedrooms"/>
                            <field name="create_date"/>
                            <field name="create_uid"/>
                            <field name="agent_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Leases">
                            <field name="lease_ids">
                            <tree create="false" delete='false'>
                            <field name="name"/>
                            <field name="property_id"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            </tree>
                            </field>   
                        </page>
                        <page string="Maintenance">
                            <field name="maintenance_ids">
                            <tree create="true" delete='false'>
                            <field name="name"/>
                            <field name="tenant_id"/>
                            <field name="property_id"/>
                            <field name="urgency"/>
                            </tree>
                            </field>   
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
        <!-- Property Kanban View -->
    <record id="view_property_kanban" model="ir.ui.view">
        <field name="name">real_estate.property.kanban</field>
        <field name="model">real_estate.property</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="price"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                            </div>
                            <div class="m1-t">
                                    <field name="price"/>
                            </div>
                            <div class="m1-t">
                                    <field name="property_type"/>
                            </div>
                            <div class="m1-t">
                                    <field name="bedrooms"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

        <!-- Properties Search View -->
    <record id="view_property_search" model="ir.ui.view">
        <field name="name">real_estate.property.search</field>
        <field name="model">real_estate.property</field>
        <field name="arch" type="xml">
            <search string="Search Propeties">
                <field name="name"/>
                <field name="price"/>
                <separator/>
                <filter string="Available" name="available" domain="[('available', '=', True)]"/>
                <filter string="Not available" name="not_available" domain="[('available', '=', False)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Type" name="group_by_type" context="{'group_by': 'property_type'}"/>
                    <filter string="Availability" name="group_by_availability" context="{'group_by': 'available'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Property Action (Links views together) -->
    <record id="action_property" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">real_estate.property</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first property
            </p>
        </field>
    </record>
</odoo>