<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- tenant List View (Tree) -->
    <record id="view_Tenant_tree" model="ir.ui.view">
    <!--model="ir.ui.view" ======= in db to be stored as a table so you can run it immediately from db instead of loading all of that every single time-->
        <field name="name">real_estate.tenant.tree</field>
        <field name="model">real_estate.tenant</field>
        <field name="arch" type="xml">
            <tree string="Tenants">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="mobile"/>
                <field name="city"/>
                <field name="date_joined"/>
                <field name="date_of_birth"/>
                <field name="notes"/>
                <field name="active"/>
                <field name="lead_id"/>
                <field name="user_id"/>
            </tree>
        </field>
    </record>

    <!-- Tenant Form View -->
    <record id="view_tenant_form" model="ir.ui.view">
        <field name="name">real_estate.tenant.form</field>
        <field name="model">real_estate.tenant</field>
        <field name="arch" type="xml">
            <form string="Tenant">
                <header>
                    <button name="update_notes" string="Update Notes with Tenant Name" groups="real_estate.group_tenant" type="object" class="oe_highlight"/> 
                    <button name="get_lead_website" string="Get Lead website in Notes" groups="real_estate.group_tenant_manager" type="object" class="oe_highlight"/> 
                    <button name="create_portal_user" type="object" string="Create Portal User" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Tenant Name" />                 
                        </h1>
                    </div>
                    <group string="Tenant Details">
                    <field name="company_type" widget="radio" options="{'horizontal': True}"/>
                        <group string="Tenant contact Details">
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="mobile"/>
                        </group>
                        <group string="Tenant Infos">
                            <field name="date_of_birth" invisible="company_type == 'company'"/>
                            <field name="city"/>
                            <field name="date_joined"/>
                            <field name="lead_id" readonly="1"/>
                            <field name="age_category" invisible="company_type == 'company'"/>
                            <field name="user_id"/>
                            <field name="property_type"/>
                            <field name="tenant_api" widget="radio" options="{'horizontal': True}"/>
                            
                        </group>
                    </group>
                    <group>
                        <group string="Tenant status in Our Property">
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="notes">
                            <field name="notes"/>
                        </page>
                        <!-- <page string="Leases">
                            <field name="lease_ids">
                            <tree create="false" delete='false'>
                            <field name="name"/>
                            <field name="property_id"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            </tree>
                            </field>   
                        </page> -->
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tenant Kanban View -->
    <record id="view_tenant_kanban" model="ir.ui.view">
        <field name="name">real_estate.tenant.kanban</field>
        <field name="model">real_estate.tenant</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="email"/>
                <field name="date_joined"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="mt-1">
                                    <field name="email" widget="email"/>
                                </div>
                                <div class="text-muted mt-1">
                                    Joined: <field name="date_joined"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Tenant Search View -->
    <record id="view_tenant_search" model="ir.ui.view">
        <field name="name">real_estate.tenant.search</field>
        <field name="model">real_estate.tenant</field>
        <field name="arch" type="xml">
            <search string="Search Tenants">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <separator/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
                <filter string="API" name="api" domain="[('tenant_api', '=', 'API')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Active" name="group_by_active" context="{'group_by': 'active'}"/>
                    <filter string="age_category" name="group_by_age_category" context="{'group_by': 'age_category'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Tenant Action (Links views together) -->
    <record id="action_tenant" model="ir.actions.act_window">
        <field name="name">Tenant</field>
        <field name="res_model">real_estate.tenant</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Tenant
            </p>
        </field>
    </record>
</odoo>

