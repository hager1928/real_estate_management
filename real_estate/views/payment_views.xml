<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Payment List View (Tree) -->
    <record id="view_payment_tree" model="ir.ui.view">
    <!--model="ir.ui.view" ======= in db to be stored as a table so you can run it immediately from db instead of loading all of that every single time-->
        <field name="name">lease.payment.tree</field>
        <field name="model">lease.payment</field>
        <field name="arch" type="xml">
            <tree string="Payment">
                <field name="name"/>
                <field name="lease_id"/>
                <field name="tenant_id"/>
                <field name="property_id"/>
                <field name="due_date"/>
                <field name="amount"/>
                <field name="payment_date"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

