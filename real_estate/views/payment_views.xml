    </record>


    <!-- Paymet Action (Links views together) -->
    <record id="action_payment" model="ir.actions.act_window">
        <field name="name">Payment</field>
        <field name="res_model">lease.payment</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Payment
            </p>
        </field>
    </record>

        <!-- cron job -->
    <record id="ir_cron_auto_at_risk_payment" model="ir.cron">
        <field name="name">Real Estate: Auto Expire Payment</field>
        <field name="model_id" ref="model_lease_payment"/>
        <field name="state">code</field>
        <field name="code">model._cron_auto_at_risk_payment()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
    </record>

</odoo>