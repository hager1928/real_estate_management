<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_agent_properties" name="Agent Portal - My Properties">
        <t t-call="portal.portal_layout">
            <div class="container mt16 o_portal_portlets">
                <div class="row">
                    <div class="col-12">
                        <nav class="breadcrumb" aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="/my/home">My Account</a></li>
                                <li class="breadcrumb-item active" aria-current="page">My Properties</li>
                            </ol>
                        </nav>
                        <h1 class="mb16">My Assigned Properties</h1>
                        
                        <t t-if="user_id">
                            <p>
                                Hello <strong><t t-esc="user_id.name"/></strong>. Below are the real estate properties assigned to your account.
                            </p>
                        </t>
                        <t t-else="">
                            <div class="alert alert-warning" role="alert">
                                User session not found.
                            </div>
                        </t>
                    </div>
                </div>

                <t t-if="properties">
                    <div class="row">
                        <t t-foreach="properties" t-as="prop">
                            <div class="col-md-6 mb-4">
                                <div class="card h-100 shadow-sm">
                                    <div class="card-body">
                                        <h5 class="card-title mb-2 text-primary">
                                            <t t-esc="prop.name"/>
                                        </h5>
                                        <p class="text-muted mb-2">
                                            <strong>Type:</strong> <t t-esc="prop.property_type"/>
                                        </p>
                                        <p class="mb-1">
                                            <strong>Monthly Rent / Price:</strong> <t t-esc="prop.price"/>
                                        </p>
                                        <p class="mb-1">
                                            <strong>Bedrooms:</strong> <t t-esc="prop.bedrooms or '—'"/>
                                        </p>
                                        <p class="mb-1">
                                            <strong>Deposit:</strong> <t t-esc="prop.deposit or '—'"/>
                                        </p>
                                        <p class="mb-1">
                                            <strong>Status:</strong> 
                                            <span t-if="prop.available" class="badge bg-success">Available</span>
                                            <span t-else="" class="badge bg-secondary">Occupied</span>
                                        </p>
                                        <p class="mt-3 text-muted small">
                                            <t t-esc="prop.description or 'No description available.'"/>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>
                <t t-else="">
                    <div class="row">
                        <div class="col-12">
                            <div class="alert alert-info" role="alert">
                                No properties are currently assigned to your sales account.
                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </t>
    </template>

    <!-- Portal Breadcrumb Menu Integration -->
    <template id="portal_my_agent_properties_menu" name="Portal My Home: My Properties" inherit_id="portal.portal_my_home" priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_service_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_service_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'fa fa-building'"/>
                <t t-set="title">My Properties</t>
                <t t-set="text">View your assigned real estate properties and details.</t>
                <t t-set="url" t-value="'/my/agent/properties'"/>
                <t t-set="config_card" t-value="True"/>
                <t t-set="placeholder_count" t-value="'property_count'"/>
            </t>
        </div>
    </template>
</odoo>