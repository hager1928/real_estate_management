<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_inherit" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="before">
                <field name="property_type"/>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="string">Sales Man</attribute>
            </xpath>   
            <xpath expr="//field[@name='date_deadline']" position="attributes">
                <attribute name="string">Expected Date</attribute>
                <attribute name="required">True</attribute>
            </xpath>   
            <xpath expr="//header" position="inside">
                <button name="get_lead_name" string="Get Lead Name" type="object" class="oe_highlight"/> 
                <button name="%(real_estate.action_tenant_wizard)d" string="Create Tenant" type="action" context="{'default_lead_id': active_id, 'default_name':name}"/>
            </xpath>         
        </field>
    </record>

    <record id="ir_cron_auto_create_tenant" model="ir.cron">
        <field name="name">auto_create_tenant</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="nextcall" eval="(DateTime.now()+timedelta(days=1)).strftime('%Y-%m-%d 01:00:00')" />
        <field name="doall" eval="False"/>
        <field name="model_id" ref="model_crm_lead"/>
        <field name="code">model._cron_auto_create_tenant()</field>
        <field name="state">code</field>
    </record>

</odoo>
