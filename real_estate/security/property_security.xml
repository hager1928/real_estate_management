<odoo>
    <record id="group_agent" model="res.groups">
        <field name="name">Real Estate Agent</field>
    </record>
    
    <record id="group_property_manager" model="res.groups">
        <field name="name">Property Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_agent'))]"/>
    </record>
    
    <record id="group_tenant" model="res.groups">
        <field name="name">Tenant</field>
    </record>

    <record id="group_lease" model="res.groups">
        <field name="name">Lease</field>
    </record>

    <record id="group_lease_manager" model="res.groups">
        <field name="name">Lease Manager</field>
    </record>

    <record id="group_tenant_manager" model="res.groups">
        <field name="name">Tenant Manager</field>
    </record>

    <!-- Define the Maintenance Request Manager Group -->
    <record id="group_maintenance_request_manager" model="res.groups">
            <field name="name">Maintenance Request Manager</field>
    </record>

    <record id="group_maintenance_request" model="res.groups">
            <field name="name">Maintenance Request</field>
    </record>

    <record id="property_agent_rule" model="ir.rule">
        <field name="name">Agent: Own Properties Only</field>
        <field name="model_id" ref="model_real_estate_property"/>
        <field name="domain_force">[('agent_id', '=', user.id)]</field> 
        <field name="groups" eval="[(4, ref('group_agent'))]"/>
    </record>

    <record id="tenant_user_rule" model="ir.rule">
        <field name="name">Related User: Own Tenant Only</field>
        <field name="model_id" ref="model_real_estate_tenant"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field> 
        <field name="groups" eval="[(4, ref('group_tenant'))]"/>
    </record>

    <!-- <record id="property_tenant_rule" model="ir.rule">
        <field name="name">Tenant: Leased Properties Only</field>
        <field name="model_id" ref="model_real_estate_property"/>
        <field name="domain_force">[('lease_ids.tenant_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_tenant'))]"/>
    </record> -->

    <record id="property_manager_rule" model="ir.rule">
        <field name="name">Manager: All Properties</field>
        <field name="model_id" ref="model_real_estate_property"/>
        <field name="domain_force">[]</field>
        <field name="groups" eval="[(4, ref('group_property_manager'))]"/>
    </record>  

    <!-- Tenant Manager Rule  -->
    <record id="tenant_manager_rule" model="ir.rule">
        <field name="name">Tenant: All Properties</field>
        <field name="model_id" ref="model_real_estate_tenant"/>
        <field name="domain_force">[]</field>
        <field name="groups" eval="[(4, ref('group_tenant_manager'))]"/>
    </record> 

    <!-- lease user -->
    <record id="lease_user_rule" model="ir.rule">
        <field name="name">User: Own Lease Only</field>
        <field name="model_id" ref="model_real_estate_lease"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field> 
        <field name="groups" eval="[(4, ref('group_lease'))]"/>
    </record>

    <!-- Lease Manager Rule  -->
    <record id="lease_manager_rule" model="ir.rule">
        <field name="name">Lease: All Properties</field>
        <field name="model_id" ref="model_real_estate_lease"/>
        <field name="domain_force">[]</field>
        <field name="groups" eval="[(4, ref('group_lease_manager'))]"/>
    </record> 

    <!-- maintenance_request Manager Rule  -->
    <record id="maintenance_request_manager_rule" model="ir.rule">
        <field name="name">Maintenance Request: All Properties</field>
        <field name="model_id" ref="model_maintenance_request"/>
        <field name="domain_force">[]</field>
        <field name="groups" eval="[(4, ref('group_tenant_manager'))]"/>
    </record> 

    <!-- maintenance_request Manager Rule  -->
    <record id="maintenance_request_manager_rule" model="ir.rule">
        <field name="name">Maintenance Request: All Properties</field>
        <field name="model_id" ref="model_maintenance_request"/>
        <field name="domain_force">[]</field>
        <field name="groups" eval="[(4, ref('group_maintenance_request_manager'))]"/>
    </record> 

    <!-- maintenance_request Rule  -->
    <record id="maintenance_request_rule" model="ir.rule">
        <field name="name">Maintenance Request: All Properties</field>
        <field name="model_id" ref="model_maintenance_request"/>
        <field name="domain_force">[('assigned_to', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_maintenance_request'))]"/>
    </record> 


</odoo>
